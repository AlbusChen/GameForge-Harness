# Copy this file to .env.local and fill values on this machine only.
# Never commit .env.local. The preferred provider profile lives in model.local.yaml;
# this file only supplies the secret named by that profile's api_key_env.
LLM_API_KEY=
OPENAI_API_KEY=
# Legacy single-profile settings retained for compatibility.
LLM_MODEL=
LLM_BASE_URL=
# Used only for local cost accounting. Set these to the provider's current prices.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
